# Copie para .env.local e ajuste conforme necessário.

# Banco de dados (libSQL). Local: arquivo SQLite; hospedado: libsql://<db>.turso.io
DATABASE_URL=file:./data/concurso.db
# Token do Turso (somente quando DATABASE_URL aponta para libsql://)
DATABASE_AUTH_TOKEN=
# Alternativa: TURSO_DATABASE_URL / TURSO_AUTH_TOKEN, já fornecidas pela integração do Turso no
# Marketplace da Vercel. Só valem quando DATABASE_URL / DATABASE_AUTH_TOKEN estão vazias.

# Autenticação (opcional). Sem login Google nem APP_PASSWORD, a autenticação fica desligada
# (uso local). Com login, todas as páginas e APIs exigem sessão, exceto /login, /api/health, o
# fluxo do Google, o manifest/ícones do PWA e /api/mcp e /api/calendario.ics (que usam token).

# Login com Google (multiusuário). Credenciais do Google Cloud Console (OAuth client "Web
# application"); redirect URI: <origem>/api/auth/google/callback. Veja o README.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Admins (obrigatório com Google), separados por vírgula. O primeiro a entrar assume os dados
# que já existiam no banco.
ADMIN_EMAILS=
# Allowlist: demais e-mails que podem entrar com Google.
ALLOWED_EMAILS=
# Origem pública para a URL de callback, se o app estiver atrás de proxy reverso (opcional).
APP_URL=

# Senha única, só para uso local: entra como o usuário inicial. Em produção não pode ser usada
# junto com o login Google.
APP_PASSWORD=
# Segredo para assinar o cookie de sessão (JWT HS256), com pelo menos 32 bytes.
# Obrigatório com qualquer login. Gere com: openssl rand -base64 32
# Trocar o segredo encerra todas as sessões abertas.
AUTH_SECRET=
# Em produção (NODE_ENV=production) sem login o app recusa iniciar,
# a menos que isto seja "true" (só para uso local, sem exposição na rede).
ALLOW_NO_AUTH=false

# Aplica as migrações ao iniciar o servidor (a imagem Docker já liga isto). Localmente e na
# Vercel elas rodam antes do dev/build.
MIGRATE_ON_START=false
# Quantos backups `pnpm db:backup` mantém em backups/.
BACKUP_KEEP=10

# Logs (ARQUITETURA.md §9.4). Nível mínimo: debug, info, warn, error ou silent
# (padrão: info em produção, debug em dev, silent nos testes).
# LOG_LEVEL=info
# Formato: json (uma linha JSON por evento) ou texto. Padrão: json em produção, texto em dev.
# LOG_FORMAT=json

# Servidor MCP por HTTP em /api/mcp: cada usuário gera o próprio token em Configurações
# (não há mais MCP_TOKEN). Localmente, use `pnpm --silent mcp` (stdio).
