# Copie para .env.local e ajuste conforme necessário.

# Banco de dados (libSQL). Local: arquivo SQLite; hospedado: libsql://<db>.turso.io
DATABASE_URL=file:./data/concurso.db
# Token do Turso (somente quando DATABASE_URL aponta para libsql://)
DATABASE_AUTH_TOKEN=

# Autenticação (opcional). Sem APP_PASSWORD a autenticação fica desligada (uso local).
APP_PASSWORD=
# Segredo para assinar a sessão (>= 32 bytes). Obrigatório quando APP_PASSWORD estiver definido.
AUTH_SECRET=
# Em produção sem APP_PASSWORD o app recusa iniciar, a menos que isto seja "true".
ALLOW_NO_AUTH=false
